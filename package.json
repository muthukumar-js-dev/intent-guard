{
  "name": "intent-guard-core",
  "version": "0.1.2",
  "description": "Prevent AI coding assistants from breaking your architecture. Validates AI-generated code against layer boundaries, protected regions, and dependency rules.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "intent-guard": "dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muthu-kumar369/intent-guard.git"
  },
  "bugs": {
    "url": "https://github.com/muthu-kumar369/intent-guard/issues"
  },
  "homepage": "https://github.com/muthu-kumar369/intent-guard#readme",
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/muthukumar"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "ai-code-validation",
    "ai-guardrails",
    "architecture-validation",
    "layer-boundaries",
    "ai-coding-assistant",
    "code-architecture",
    "ai-code-guard",
    "architectural-linter",
    "cursor",
    "copilot",
    "windsurf",
    "clean-architecture",
    "hexagonal-architecture",
    "protected-code",
    "dependency-rules",
    "ai-code-quality",
    "static-analysis",
    "monorepo-validation",
    "typescript-validation",
    "javascript-validation"
  ],
  "author": "Muthu Kumar",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "glob": "^10.0.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4"
  }
}
